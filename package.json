{
  "name": "dsh-workbuddy-credits",
  "version": "1.1.0",
  "description": "WorkBuddy credit panel for DeepSeek Harness: a resident Web sidebar panel for balance, expiry spread, and free models, with manual refresh. 把 WorkBuddy 积分查询固化成 GUI 侧栏面板。",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Fancy Lee",
    "url": "https://github.com/fancylear"
  },
  "homepage": "https://github.com/fancylear/dsh-workbuddy-credits#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fancylear/dsh-workbuddy-credits.git"
  },
  "bugs": {
    "url": "https://github.com/fancylear/dsh-workbuddy-credits/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "dsh",
    "workbuddy",
    "codebuddy",
    "credits",
    "quota",
    "sidebar",
    "panel"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "scripts": {
    "test": "node test/run-all.mjs",
    "test:live": "node test/run-all.mjs --live",
    "set-owner": "node scripts/set-owner.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:npm": "node scripts/release.mjs npm",
    "release:github": "node scripts/release.mjs github",
    "release:npm:dry": "node scripts/release.mjs npm --dry-run",
    "release:github:dry": "node scripts/release.mjs github --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
